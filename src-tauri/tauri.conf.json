{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DownloadAny",
  "version": "0.1.1",
  "identifier": "com.dengjun.downloadany",
  "build": {
    "beforeDevCommand": "node scripts/fetch-binaries.mjs && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/fetch-binaries.mjs && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DownloadAny",
        "width": 1045,
        "height": 707,
        "minWidth": 1045,
        "minHeight": 707
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: http: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8000 http://127.0.0.1:8001"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxMjMxNUY1NjI3QUQ0RUUKUldUdTFIcGk5UlVqd1lxMkxDSkNsVk9uc1kweDZBUVJWTXZwaUwrTzA5V3p3bHBpZFNqVUJQVWQK",
      "endpoints": [
        "https://github.com/Djttt/DownloadAny/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
